rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if user is admin
    // Note: In a real app, this should check Custom Claims from Firebase Auth, 
    // but here we check if they have a true 'isAdmin' field in members collection.
    // However, to prevent chicken-and-egg, it's safer to use custom claims.
    // For simplicity of this prototype, we'll allow authenticated users to read/write their own data
    // and admins to read/write all data based on custom claim 'admin' === true.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    // MEMBERS
    match /members/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Allow create so new users can register
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // PACKAGES
    match /packages/{packageId} {
      // Anyone can read active packages (for landing page)
      allow read: if true;
      allow write: if isAdmin();
    }

    // MEMBERSHIPS
    match /memberships/{membershipId} {
      allow read: if isAuthenticated() && (resource.data.memberId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.memberId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // PAYMENTS
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (resource.data.memberId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.memberId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // SETTINGS
    match /settings/{settingId} {
      allow read: if true; // Allows landing page to read gym name etc if needed
      allow write: if isAdmin();
    }

    // REMINDERS (Logs)
    match /reminders/{reminderId} {
      allow read: if isAdmin();
      allow write: if isAdmin(); // Usually written by Cloud Functions which bypass rules
    }
  }
}
